# API and worker runtime (DML role only)
DATABASE_URL=postgresql+psycopg://testgap_app:<app-password>@127.0.0.1:5432/testgap

# Migration job only (DDL-capable role; never used by API or workers)
MIGRATION_DATABASE_URL=postgresql+psycopg://testgap_migrator:<migration-password>@127.0.0.1:5432/testgap

# Tests only; must never point at a production database
TEST_DATABASE_URL=postgresql+psycopg://testgap_test:<test-password>@127.0.0.1:5432/testgap_test

# Allowed values: local, ci
TESTGAP_RUNTIME=local

# Local Compose PostgreSQL only
POSTGRES_PASSWORD=<bootstrap-password>
POSTGRES_APP_PASSWORD=<app-password>
POSTGRES_MIGRATION_PASSWORD=<migration-password>
POSTGRES_TEST_PASSWORD=<test-password>
POSTGRES_HOST_PORT=5432
